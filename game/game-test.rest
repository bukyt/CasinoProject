### Base URL
@baseUrl = http://localhost:8082

##############################################
### 1. LIST GAMES
##############################################
GET {{baseUrl}}/games
Accept: application/json

###

##############################################
### 2. CREATE SESSION
# Your controller uses AtomicLong, so the ID will be "session-1" on first run
##############################################
POST {{baseUrl}}/games/sessions
Content-Type: application/json

{
  "gameId": "slot-machine",
  "initialBalance": 100.0,
  "playerProfileId": 123
}

###

# IMPORTANT: Look at the response from step 2. 
# If it's your first run, it's session-1.
@sessionId = session-1

##############################################
### 3. PLACE BET (HAPPY PATH)
##############################################
POST {{baseUrl}}/games/sessions/{{sessionId}}/bets
Content-Type: application/json

{
  "amount": 10.0
}

###

##############################################
### 4. GET SESSION (PROVE PERSISTENCE)
# The balance should now be 90.0 (loss) or 110.0 (win)
# The "bets" list should NOT be empty.
##############################################
GET {{baseUrl}}/games/sessions/{{sessionId}}
Accept: application/json

###

##############################################
### 5. CLOSE SESSION
##############################################
PATCH {{baseUrl}}/games/sessions/{{sessionId}}/close
Content-Type: application/json

###

##############################################
### 6. VERIFY LEDGER (8083)
##############################################
GET http://localhost:8083/ledger/player/123/balance
Accept: application/json