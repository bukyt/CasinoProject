##############################################
# BASE URLS
##############################################

@gameUrl = http://localhost:8082
@walletUrl = http://localhost:8085

##############################################
# 1. LIST GAMES
##############################################
GET {{gameUrl}}/games
Accept: application/json

###

##############################################
# 2. CREATE WALLET
##############################################
POST {{walletUrl}}/wallet/create/123
Accept: application/json

###

##############################################
# 3. ADD FUNDS TO WALLET (DEBIT = ADD MONEY)
##############################################
POST {{walletUrl}}/wallet/debit/123
Content-Type: application/json

{
  "amount": 100.00
}

###

##############################################
# 4. CHECK WALLET
##############################################
GET {{walletUrl}}/wallet/123
Accept: application/json

###

##############################################
# 5. CREATE GAME SESSION
##############################################
POST {{gameUrl}}/games/sessions
Content-Type: application/json

{
  "gameId": "slot-machine",
  "initialBalance": 100.0,
  "playerProfileId": 123
}

###

##############################################
# IMPORTANT: update after response
# Example:
@sessionId = session-1

##############################################
# 6. PLACE BET (WALLET CREDIT + DEBIT FLOW INSIDE GAME)
##############################################
POST {{gameUrl}}/games/sessions/{{sessionId}}/bets
Content-Type: application/json

{
  "amount": 10.0
}

###

##############################################
# 7. GET SESSION (VERIFY BET HISTORY ONLY)
##############################################
GET {{gameUrl}}/games/sessions/{{sessionId}}
Accept: application/json

###

##############################################
# 8. CLOSE SESSION
##############################################
PATCH {{gameUrl}}/games/sessions/{{sessionId}}/close
Accept: application/json

###

##############################################
# 9. FINAL WALLET CHECK (MONEY IS SOURCE OF TRUTH)
##############################################
GET {{walletUrl}}/wallet/123
Accept: application/json

###

##############################################
# 10. LEDGER CHECK (IF YOU STILL USE IT)
##############################################
GET http://localhost:8083/ledger/player/123/balance
Accept: application/json