# Dockerfile.service

FROM maven:3.9-eclipse-temurin-17 AS build

ARG SERVICE_MODULE
ARG SERVICE_PORT=8080

WORKDIR /app

# Use Docker-specific parent POM without <modules>
COPY docker-parent-pom.xml ./pom.xml

# Copy only the shared module and selected service
COPY common ./common
COPY ${SERVICE_MODULE} ./${SERVICE_MODULE}

# Install parent POM into local Maven repository
RUN mvn -B org.apache.maven.plugins:maven-install-plugin:3.1.3:install-file \
    -Dfile=pom.xml \
    -DpomFile=pom.xml \
    -DgroupId=com.casino \
    -DartifactId=casino-parent \
    -Dversion=1.0.0 \
    -Dpackaging=pom

# Build and install common
RUN mvn -B -f common/pom.xml clean install -DskipTests

# Build selected service
RUN mvn -B -f ${SERVICE_MODULE}/pom.xml clean package -DskipTests


FROM eclipse-temurin:17-jre-alpine

ARG SERVICE_MODULE
ARG SERVICE_PORT=8080

WORKDIR /app

COPY --from=build /app/${SERVICE_MODULE}/target/*.jar app.jar

EXPOSE ${SERVICE_PORT}

ENTRYPOINT ["java", "-jar", "app.jar"]